# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.

aws_region          = "us-east-1"
aws_profile         = "my-prod-profile"
allowed_account_ids = ["222222222222"]

name_prefix = "myapp-prod"

vpc_cidr             = "10.20.0.0/16"
azs                  = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs  = ["10.20.0.0/20", "10.20.16.0/20", "10.20.32.0/20"]
private_subnet_cidrs = ["10.20.64.0/18", "10.20.128.0/18", "10.20.192.0/18"]

kubernetes_version  = "1.31"
node_instance_types = ["m6i.large"]
node_desired_size   = 3
node_max_size       = 9
